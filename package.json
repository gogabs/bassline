{
  "name": "bassline",
  "version": "0.1.0",
  "private": true,
  "description": "Transforma tablaturas de baixo em um formato acessível para baixistas cegos, pensado para o NVDA.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "servidor": "tsx server/index.ts",
    "build": "vite build",
    "inicio": "npm run build && npm run servidor",
    "test": "vitest run",
    "test:e2e": "node e2e/teclado.cjs",
    "test:backing": "node e2e/backing.cjs",
    "typecheck": "tsc --noEmit",
    "parse": "tsx scripts/parse.ts"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.5",
    "axe-core": "^4.14.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^6.4.5",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "demucs-web": "^1.0.2",
    "onnxruntime-web": "^1.31.1",
    "preact": "^10.29.8"
  }
}
